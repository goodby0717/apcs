n,p=map(str,input().split())
n=int(n)
p=list(p)
p.reverse()
it=0
g=1
max_a=-100
max_g=0
all_g=0
while it <len(p):
    #print('it=',it)
    all_g += int(p[it])
    it += 1
    if it % n==0:
        if all_g>=max_a:
            max_a = all_g
            max_g=g
        all_g=0
        g+=1
if all_g>=max_a:
    max_a=all_g
    max_g=g
print(max_g,max_a)
