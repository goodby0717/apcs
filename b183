n,m=map(int,input().split())
a=[]
for i in range(n):
    b=list(map(int,input().split()))
    a.append(b)
c=[]
for i in range(n):
    b=list(map(int,input().split()))
    c.append(b)
d=[]
for i in range(n):
    b=[0 for j in range(m)]
    d.append(b)
for i in range(n):
    for j in range(m):
        if c[i][j]==1:
            if i==0 or i==n-1:
                d[i][j]=int((a[i][j]-1)/2)
            else:
                d[i][j]=int(a[i][j]/2)
        else:
            if i==0 or i==n-1:
                d[i][j]=a[i][j]-1
            else:
                d[i][j]=a[i][j]
for i in range(n):
    for j in range(m):
        print(d[i][j],end=' ')             
    print()
